# ===== 依赖与构建产物（构建上下文中不需要） =====
node_modules
npm-debug.log
npm-debug.log.*
.npm
.pnp
.pnp.js
yarn-error.log

# ===== 构建产物 =====
dist
build
.next
out
coverage
*.tsbuildinfo
tsconfig.tsbuildinfo

# ===== 环境变量与密钥（防止误打入镜像） =====
.env
.env.local
.env.*.local
.env.development
.env.production

# ===== 测试与日志 =====
test
*.log
logs

# ===== 版本控制与 IDE =====
.git
.gitignore
.github
.vscode
.idea
*.swp
*.swo

# ===== Docker 自身文件（避免递归构建） =====
Dockerfile
.dockerignore

# ===== 文档（运行时不需要） =====
README.md
*.md
docs

# ===== 上传目录（不应进入镜像） =====
uploads
backend/uploads

