// 盆景平台数据库模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

// 用户
model User {
  id                   Int       @id @default(autoincrement())
  username             String    @unique @db.VarChar(50)
  email                String    @unique @db.VarChar(100)
  password             String    @db.VarChar(255)
  role                 Role      @default(USER)
  avatar               String?   @db.VarChar(500)
  phone                String?   @db.VarChar(20)
  status               Int       @default(1) // 1启用 0禁用
  // 安全字段：登录失败计数与锁定
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until") // 锁定截止时间，null 表示未锁定
  lastLoginAt          DateTime? @map("last_login_at") // 最后登录时间
  lastLoginIp          String?   @map("last_login_ip") @db.VarChar(45) // 最后登录 IP
  lastActiveAt         DateTime? @map("last_active_at") // 最后活动时间
  passwordChangedAt    DateTime  @default(now()) @map("password_changed_at") // 密码修改时间，用于强制旧 token 失效
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  favorites  Favorite[]
  chatRooms  ChatRoom[]   @relation("UserRooms")
  messages   ChatMessage[]
  viewLogs   ViewLog[]

  @@index([lockedUntil])
  @@map("users")
}

// 分类
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(50)
  description String?  @db.Text
  coverImage  String?  @db.VarChar(500) @map("cover_image")
  sort        Int      @default(0)
  status      Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bonsais Bonsai[]

  @@map("categories")
}

// 盆景商品
model Bonsai {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  slug       String    @unique @db.VarChar(120)
  description String   @db.Text
  price      Decimal   @db.Decimal(10, 2)
  stock      Int       @default(0)
  origin     String    @db.VarChar(100) // 产地
  year       Int // 年份
  treeAge    Int?      @map("tree_age") // 树龄
  height     Int? // 高度(cm)
  width      Int? // 宽度(cm)
  video      String?   @db.VarChar(500) // 盆景展示视频 URL（可选）
  categoryId Int       @map("category_id")
  status     Int       @default(1) // 1上架 0下架
  isFeatured Boolean   @default(false) @map("is_featured")
  viewCount  Int       @default(0) @map("view_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at") // 软删除

  category  Category     @relation(fields: [categoryId], references: [id])
  images    BonsaiImage[]
  favorites Favorite[]
  chatRooms ChatRoom[]
  viewLogs  ViewLog[]

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured]) // 精选盆景查询加速
  @@index([viewCount])  // 热门盆景排序加速
  // 复合索引：列表分页查询高频组合（status + 软删除 + 时间排序）
  @@index([status, deletedAt, createdAt])
  // 复合索引：精选列表查询（status + 软删除 + 精选标记）
  @@index([isFeatured, status, deletedAt])
  // 复合索引：同分类盆景推荐查询（findRelated：categoryId + status + 软删除过滤）
  @@index([categoryId, status, deletedAt])
  @@map("bonsais")
}

// 站点设置（键值对存储，用于联系方式、关于我们等可配置内容）
// 使用 key-value 结构而非 JSON 字段，便于后台按 key 单独更新、按需查询
model SiteSetting {
  key       String   @id @db.VarChar(50) // 设置键，如 phone / email / address / show_phone
  value     String   @db.Text // 设置值
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// 站点布局（主页可配置区块，sections 为 JSON 数组）
// 一个 key（如 "homepage"）可对应多条记录，但同一时刻仅一条 isActive=true
model SiteLayout {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(50) // 布局键，如 "homepage"
  sections  Json     // 区块配置数组：[{ id, type, title, subtitle, visible, config, order }]
  isActive  Boolean  @default(false) @map("is_active") // 是否当前激活的布局
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("site_layouts")
}

// 盆景图片
model BonsaiImage {
  id        Int      @id @default(autoincrement())
  bonsaiId  Int      @map("bonsai_id")
  url       String   @db.VarChar(500)
  isMain    Boolean  @default(false) @map("is_main")
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  bonsai Bonsai @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId])
  @@map("bonsai_images")
}

// 收藏
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  bonsaiId  Int      @map("bonsai_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bonsai Bonsai @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@unique([userId, bonsaiId])
  @@index([userId])
  @@index([createdAt]) // 收藏趋势查询加速
  @@map("favorites")
}

// 聊天会话
model ChatRoom {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  bonsaiId  Int?     @map("bonsai_id") // 可选关联盆景
  status    Int      @default(0) // 0未处理 1已处理
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation("UserRooms", fields: [userId], references: [id])
  bonsai   Bonsai?       @relation(fields: [bonsaiId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId])
  @@index([status]) // 管理员筛选未处理会话加速
  @@index([updatedAt]) // 管理员列表按 updatedAt 排序加速
  // 复合索引：createRoom 复用会话查询（userId + bonsaiId），避免会话重复创建
  @@index([userId, bonsaiId])
  @@map("chat_rooms")
}

// 聊天消息
model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int      @map("room_id")
  senderId  Int      @map("sender_id")
  content   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id])

  @@index([roomId])
  @@index([senderId]) // 按发送者查询加速
  @@index([createdAt]) // 消息按时间排序加速
  // 复合索引：会话消息分页查询（roomId + createdAt 降序），避免 filesort
  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// 浏览日志（数据分析用）
model ViewLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id") // 未登录为 null
  bonsaiId  Int      @map("bonsai_id")
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500) @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  bonsai Bonsai @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId])
  @@index([createdAt])
  // 复合索引：按盆景统计浏览量趋势（bonsaiId + createdAt 范围查询）
  @@index([bonsaiId, createdAt])
  @@index([userId]) // 按用户查询浏览历史加速
  @@map("view_logs")
}
