# ========== 后端环境变量 ==========
# 重要：所有密钥/密码必须通过环境变量显式注入
# 生成 JWT 密钥：openssl rand -hex 32

# 数据库（生产环境强制注入，不提供默认值）
DATABASE_URL="mysql://penjing:CHANGE_ME@localhost:3306/penjing_db"
MYSQL_ROOT_PASSWORD="REPLACE_WITH_STRONG_ROOT_PASSWORD"
MYSQL_PASSWORD="REPLACE_WITH_STRONG_APP_PASSWORD"

# Redis（生产环境强制注入密码）
REDIS_URL="redis://:CHANGE_ME@localhost:6379"
REDIS_PASSWORD="REPLACE_WITH_STRONG_REDIS_PASSWORD"
# Redis 内存上限与淘汰策略（已在 docker-compose.yml 中配置为 256mb / allkeys-lru）
# 调整需同步修改 docker-compose.yml 中 redis 服务的 command 段

# JWT（必须 32 字节以上，使用 openssl rand -hex 32 生成）
JWT_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING_FROM_OPENSSL_RAND_HEX_32"
JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_RANDOM_64_CHAR_HEX_STRING"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 服务
PORT=4000
NODE_ENV="production"
API_PREFIX="api/v1"
# 生产环境通过 Nginx 反向代理到 https://<YOUR_DOMAIN>
# 多个来源用逗号分隔（不含空格），如：https://penjing.example.com,https://www.penjing.example.com
CORS_ORIGIN="https://penjing.example.com"

# 文件上传
UPLOAD_DIR="./uploads"
# 与 Nginx client_max_body_size 对齐（留余量给 multipart 头），单位字节
MAX_FILE_SIZE=5242880

# 管理员初始化（生产环境强制注入，至少 10 位且含字母与数字）
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_10_CHARS"

# 可选：第二个管理员账号（脱敏设计：所有账号均通过环境变量注入）
# 留空则不创建；填写则在首次部署时自动创建第二个管理员
ADMIN2_USERNAME=""
ADMIN2_EMAIL=""
ADMIN2_PASSWORD=""

# ========== 前端环境变量 ==========
# 生产环境通过 Nginx 反向代理（https://<YOUR_DOMAIN>），使用相对路径同源访问
NEXT_PUBLIC_API_URL="/api/v1"
# 留空表示同源（生产环境推荐），开发环境可填 ws://localhost:4000
NEXT_PUBLIC_SOCKET_URL=""
# 可选：前端图片优化允许的额外域名（逗号分隔）
# 生产部署时填入真实后端域名（用户上传图片的访问域名）
NEXT_PUBLIC_IMAGE_DOMAINS=""

# ========== 运维相关（可选，主要在 docker-compose.yml / 部署脚本中配置） ==========
# 以下变量不需要在 .env 中显式配置，但了解其用途有助于运维：
#
# - BACKUP_DIR：MySQL 备份目录，默认 /opt/penjing-backups（backup.sh 使用）
# - BACKUP_RETAIN_DAYS：备份保留天数，默认 7（backup.sh 使用）
# - DEPLOY_DIR：部署目录，默认 /opt/penjing（deploy.sh / remote-setup.sh 使用）
#
# 容器资源限制与日志驱动配置位于 docker-compose.yml，调整需修改该文件
